generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admins {
  admin_id        BigInt            @id @default(autoincrement())
  username        String            @unique(map: "username") @db.VarChar(50)
  email           String            @unique(map: "email") @db.VarChar(255)
  password_hash   String            @db.VarChar(255)
  display_name    String?           @db.VarChar(100)
  created_at      DateTime          @default(now()) @db.Timestamp(0)
  is_active       Boolean?          @default(true)
  last_login      DateTime          @default(dbgenerated("('0000-00-00 00:00:00')")) @db.Timestamp(0)
  post_moderation post_moderation[]
  user_moderation user_moderation[]

  @@index([email], map: "idx_email")
  @@index([username], map: "idx_username")
}

model comments {
  comment_id        BigInt            @id @default(autoincrement())
  post_id           String            @db.Char(36)
  user_id           String            @db.Char(36)
  comment_text      String            @db.Text
  parent_comment_id BigInt?
  created_at        DateTime          @default(now()) @db.Timestamp(0)
  updated_at        DateTime          @default(now()) @db.Timestamp(0)
  is_deleted        Boolean?          @default(false)
  posts             posts             @relation(fields: [post_id], references: [post_id], onDelete: Cascade, onUpdate: Restrict, map: "comments_ibfk_1")
  users             users             @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Restrict, map: "comments_ibfk_2")
  comments          comments?         @relation("commentsTocomments", fields: [parent_comment_id], references: [comment_id], onDelete: Cascade, onUpdate: Restrict, map: "comments_ibfk_3")
  other_comments    comments[]        @relation("commentsTocomments")
  post_moderation   post_moderation[]

  @@index([parent_comment_id], map: "idx_parent_comment")
  @@index([post_id], map: "idx_post_id")
  @@index([user_id], map: "idx_user_id")
}

model dashboard_stats {
  stat_id         BigInt   @id @default(autoincrement())
  stat_date       DateTime @unique(map: "stat_date") @db.Date
  total_users     Int?     @default(0)
  new_users_today Int?     @default(0)
  total_posts     Int?     @default(0)
  new_posts_today Int?     @default(0)
  total_comments  Int?     @default(0)
  total_reactions Int?     @default(0)
  active_bans     Int?     @default(0)
  created_at      DateTime @default(now()) @db.Timestamp(0)

  @@index([stat_date], map: "idx_stat_date")
}

model fa {
  user_id    String   @id @db.Char(36)
  temp_token String   @db.VarChar(255)
  code       String?  @db.VarChar(20)
  expires_at DateTime @default(now()) @db.Timestamp(0)
  users      users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Restrict, map: "fa_ibfk_1")

  @@index([expires_at], map: "idx_2fa_expires_at")
}

model favorites {
  favorite_id BigInt @id @default(autoincrement())
  user_id     String @db.Char(36)
  post_id     String @db.Char(36)
  users       users  @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Restrict, map: "favorites_ibfk_1")
  posts       posts  @relation(fields: [post_id], references: [post_id], onDelete: Cascade, onUpdate: Restrict, map: "favorites_ibfk_2")

  @@unique([user_id, post_id], map: "unique_user_post_favorite")
  @@index([post_id], map: "idx_post_id")
  @@index([user_id], map: "idx_user_id")
}

model ingredients {
  ingredient_id   BigInt @id @default(autoincrement())
  post_id         String @db.Char(36)
  item_order      Int
  ingredient_text String @db.VarChar(500)
  ingredient_unit String @db.VarChar(255)
  posts           posts  @relation(fields: [post_id], references: [post_id], onDelete: Cascade, onUpdate: Restrict, map: "ingredients_ibfk_1")

  @@index([post_id], map: "idx_post_id")
}

model moderators {
  moderator_id    BigInt            @id @default(autoincrement())
  username        String            @unique(map: "username") @db.VarChar(50)
  email           String            @unique(map: "email") @db.VarChar(255)
  password_hash   String            @db.VarChar(255)
  display_name    String?           @db.VarChar(100)
  created_at      DateTime          @default(now()) @db.Timestamp(0)
  is_active       Boolean?          @default(true)
  last_login      DateTime          @default(dbgenerated("('0000-00-00 00:00:00')")) @db.Timestamp(0)
  post_moderation post_moderation[]
  user_moderation user_moderation[]

  @@index([email], map: "idx_email")
  @@index([username], map: "idx_username")
}

model post_edit_history {
  history_id  BigInt                        @id @default(autoincrement())
  post_id     String                        @db.Char(36)
  title       String?                       @db.VarChar(255)
  description String?                       @db.Text
  cook_time   Int?
  servings    Int?
  difficulty  post_edit_history_difficulty?
  edited_at   DateTime                      @default(now()) @db.Timestamp(0)
  posts       posts                         @relation(fields: [post_id], references: [post_id], onDelete: Cascade, onUpdate: Restrict, map: "post_edit_history_ibfk_1")

  @@index([edited_at], map: "idx_edited_at")
  @@index([post_id], map: "idx_post_id")
}

model post_moderation {
  action_id         BigInt                      @id @default(autoincrement())
  moderator_id      BigInt?
  admin_id          BigInt?
  target_type       post_moderation_target_type
  target_post_id    String?                     @db.Char(36)
  target_comment_id BigInt?
  reason            String?                     @db.Text
  created_at        DateTime                    @default(now()) @db.Timestamp(0)
  moderators        moderators?                 @relation(fields: [moderator_id], references: [moderator_id], onUpdate: Restrict, map: "post_moderation_ibfk_1")
  admins            admins?                     @relation(fields: [admin_id], references: [admin_id], onUpdate: Restrict, map: "post_moderation_ibfk_2")
  posts             posts?                      @relation(fields: [target_post_id], references: [post_id], onUpdate: Restrict, map: "post_moderation_ibfk_3")
  comments          comments?                   @relation(fields: [target_comment_id], references: [comment_id], onUpdate: Restrict, map: "post_moderation_ibfk_4")

  @@index([admin_id], map: "admin_id")
  @@index([created_at], map: "idx_created_at")
  @@index([target_comment_id], map: "idx_target_comment")
  @@index([target_post_id], map: "idx_target_post")
  @@index([moderator_id], map: "moderator_id")
}

model posts {
  post_id           String              @id @db.Char(36)
  user_id           String              @db.Char(36)
  title             String              @db.VarChar(255)
  description       String?             @db.Text
  cook_time         Int?
  servings          Int?
  difficulty        posts_difficulty?
  cover_image_url   String?             @db.VarChar(500)
  created_at        DateTime            @default(now()) @db.Timestamp(0)
  updated_at        DateTime            @default(now()) @db.Timestamp(0)
  is_deleted        Boolean?            @default(false)
  deleted_at        DateTime?           @db.Timestamp(0)
  deleted_by        String?             @db.Char(36)
  comments          comments[]
  favorites         favorites[]
  ingredients       ingredients[]
  post_edit_history post_edit_history[]
  post_moderation   post_moderation[]
  users             users               @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Restrict, map: "posts_ibfk_1")
  reactions         reactions[]
  steps             steps[]

  @@index([created_at], map: "idx_created_at")
  @@index([is_deleted], map: "idx_is_deleted")
  @@index([user_id], map: "idx_user_id")
}

model reactions {
  reaction_id   BigInt                   @id @default(autoincrement())
  post_id       String                   @db.Char(36)
  user_id       String                   @db.Char(36)
  reaction_type reactions_reaction_type? @default(like)
  created_at    DateTime                 @default(now()) @db.Timestamp(0)
  posts         posts                    @relation(fields: [post_id], references: [post_id], onDelete: Cascade, onUpdate: Restrict, map: "reactions_ibfk_1")
  users         users                    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Restrict, map: "reactions_ibfk_2")

  @@unique([user_id, post_id], map: "unique_user_post_reaction")
  @@index([post_id], map: "idx_post_id")
  @@index([user_id], map: "idx_user_id")
}

model steps {
  step_id          BigInt  @id @default(autoincrement())
  post_id          String  @db.Char(36)
  step_number      Int
  step_description String  @db.Text
  image_url        String? @db.VarChar(500)
  posts            posts   @relation(fields: [post_id], references: [post_id], onDelete: Cascade, onUpdate: Restrict, map: "steps_ibfk_1")

  @@index([post_id], map: "idx_post_id")
}

model user_moderation {
  action_id    BigInt                      @id @default(autoincrement())
  user_id      String                      @db.Char(36)
  moderator_id BigInt?
  admin_id     BigInt?
  action_type  user_moderation_action_type
  reason       String                      @db.Text
  created_at   DateTime                    @default(now()) @db.Timestamp(0)
  users        users                       @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Restrict, map: "user_moderation_ibfk_1")
  moderators   moderators?                 @relation(fields: [moderator_id], references: [moderator_id], onUpdate: Restrict, map: "user_moderation_ibfk_2")
  admins       admins?                     @relation(fields: [admin_id], references: [admin_id], onUpdate: Restrict, map: "user_moderation_ibfk_3")

  @@index([admin_id], map: "admin_id")
  @@index([created_at], map: "idx_created_at")
  @@index([user_id], map: "idx_user_id")
  @@index([moderator_id], map: "moderator_id")
}

model users {
  user_id           String            @id @db.Char(36)
  username          String?           @unique(map: "username") @db.VarChar(50)
  email             String            @unique(map: "email") @db.VarChar(255)
  password_hash     String            @db.VarChar(255)
  display_name      String?           @db.VarChar(100)
  bio               String?           @db.Text
  profile_image_url String?           @db.VarChar(500)
  created_at        DateTime          @default(now()) @db.Timestamp(0)
  updated_at        DateTime          @default(now()) @db.Timestamp(0)
  last_login        DateTime          @default(now()) @db.Timestamp(0)
  is_verified       Boolean?          @default(false)
  is_active         Boolean?          @default(true)
  comments          comments[]
  fa                fa?
  favorites         favorites[]
  posts             posts[]
  reactions         reactions[]
  user_moderation   user_moderation[]

  @@index([email], map: "idx_email")
  @@index([username], map: "idx_username")
}

enum post_moderation_target_type {
  post
  comment
}

enum reactions_reaction_type {
  like
  heart
  yum
}

enum user_moderation_action_type {
  warning
  ban
}

enum posts_difficulty {
  easy
  medium
  hard
}

enum post_edit_history_difficulty {
  easy
  medium
  hard
}
